#!/bin/sh

set -e

COLOR_RED='\033[0;31m'
COLOR_GREEN='\033[0;32m'
COLOR_PURPLE='\033[0;35m'
COLOR_OFF='\033[0m'

echo() {
    printf '%b\n' "$*"
}

abort() {
    EXIT_STATUS_CODE="$1"
    shift
    printf '%b\n' "${COLOR_RED}💔  $*${COLOR_OFF}" >&2
    exit "$EXIT_STATUS_CODE"
}

run() {
    echo "${COLOR_PURPLE}==>${COLOR_OFF} ${COLOR_GREEN}$@${COLOR_OFF}"
    eval "$@"
}

##############################################################################

#git config --global user.name  leleliu008
#git config --global user.email leleliu008@gmail.com

run curl -L -o ndk-pkg-formula-repository-official-core-master.zip https://github.chenc.dev/https://github.com/leleliu008/ndk-pkg-formula-repository-official-core/archive/refs/heads/master.zip
rm -rf ndk-pkg-formula-repository-official-core-master
run unzip -q ndk-pkg-formula-repository-official-core-master.zip
cd ndk-pkg-formula-repository-official-core-master/formula/

ls *.yml | sed 's|\.yml$||' | sort | uniq > a

sed -n '/^dep-pkg:/p' *.yml | cut -c10- | tr ' ' '\n' | sort | uniq > b

###################################

SED="sed -e s|^-||"

for item in libskia_shared libskia_static libv8_shared libv8_static libpdfium libfolly cpprestsdk d8 webrtc fortune krb5 far2l fish yazi busybox util-linux tensorflow-lite $XXXX
do
    SED="$SED -e /^$item$/d"
done

printf "SED=%s\n" "$SED"

PKGS="$(diff -U 0 a b | sed '/^--/d' | grep '^-' | $SED)"

PKGS_COUNT="$(printf "$PKGS" | wc -l)"
PKGS_COUNT="$(($PKGS_COUNT + 1))"

echo "PKGS_COUNT=$PKGS_COUNT"

cd -

##############################################################################

for API_LEVEL in $(seq 26 37)
do
    cd ~/github.com

    REPONAME="uppm-package-repository-android-$API_LEVEL-aarch64"

    if [ -d "$REPONAME" ] ; then
        run cd "$REPONAME"
        run git pull
    else
        run git clone "git@github.com:leleliu008/$REPONAME.git"
        run cd "$REPONAME"
    fi

    cat > .github/workflows/publish.yml <<EOF
name: publish a new release

permissions:
  contents: write

on:
  workflow_dispatch:

  schedule:
    # every monday UTC 00:00
    - cron: '0 0 * * 1'

jobs:
EOF

    ##################################

    unset ITEMS
    unset NEEDS

    I=0
    J=0
    K=0

    for item in $PKGS
    do
        if [ -z "$ITEMS" ] ; then
            ITEMS="$item"
        else
            ITEMS="$ITEMS, $item"
        fi

        K=$(($K + 1))

        J=$(($J + 1))

        #echo "J=$J"
        #echo "K=$K"

        if [ "$J" = 256 ] || [ "$K" = "$PKGS_COUNT" ] ; then
            J=0
            I=$(($I + 1))

            cat >> .github/workflows/publish.yml <<EOF

  build$I:
    strategy:
      fail-fast: false
      matrix:
        pkg: [$ITEMS]

    runs-on: ubuntu-latest

    steps:
      - run: curl -LO https://raw.githubusercontent.com/leleliu008/ndk-pkg/master/ndk-pkg
      - run: chmod a+x ndk-pkg

      - run: ./ndk-pkg about
      - run: ./ndk-pkg setup
      - run: ./ndk-pkg update

      - run: cd ~/.ndk-pkg/repos.d/official-core/formula/ && sed -i -e '/^dep-pkg:/s|libcares||' -e '/enable-ares/d' curl.yml libcurl.yml

      - run: ./ndk-pkg install android-$API_LEVEL-arm64-v8a/\${{ matrix.pkg }}

      - name: bundle
        run: |
          set -ex

          for item in \$(./ndk-pkg ls-installed)
          do
              ./ndk-pkg bundle "\$item" .tar.xz

              PACKAGE_SUMMARY="\$(./ndk-pkg show "\$item" summary)"
              PACKAGE_WEB_URL="\$(./ndk-pkg show "\$item" web-url)"
              PACKAGE_VERSION="\$(./ndk-pkg show "\$item" version)"

              PACKAGE_NAME="\${item#*/}"

              PACKAGE_FILENAME="\$(ls \${PACKAGE_NAME%@*}-\$PACKAGE_VERSION-*.tar.xz)"

              PACKAGE_BIN_SHA="\$(sha256sum "\$PACKAGE_FILENAME" | cut -d ' ' -f1)"

              cat > "\$PACKAGE_NAME.yml" <<EOF
          summary: \$PACKAGE_SUMMARY
          webpage: \$PACKAGE_WEB_URL
          version: \$PACKAGE_VERSION
          bin-url: \$PACKAGE_FILENAME
          bin-sha: \$PACKAGE_BIN_SHA
          EOF
          done

      - uses: actions/upload-artifact@v6
        with:
          name: \${{ matrix.pkg }}
          path: |
            ./*.tar.xz
            ./*.yml
EOF

            unset ITEMS

            if [ -z "$NEEDS" ] ; then
                NEEDS="build$I"
            else
                NEEDS="$NEEDS, build$I"
            fi
        fi
    done

    ##################################

    cat >> .github/workflows/publish.yml <<EOF

  publish:
    needs: [$NEEDS]

    runs-on: ubuntu-latest

    env:
      GH_TOKEN: \${{ github.token }}

    steps:
      - uses: actions/checkout@v6

      - uses: actions/download-artifact@v8
        with:
          pattern: '*'
          path: .
          merge-multiple: true

      - run: ls

      - id: ts
        run: |
          TS="\$(date +%Y.%m.%d)"
          printf 'TS=%s\n' "\$TS" >> "\$GITHUB_OUTPUT"

      - run: |
          set -ex

          I=0
          J=0
          K=1

          for f in *.yml
          do
            I="\$((\$I + 1))"

            if [ "\$I" -eq "\$K" ] ; then
                J="\$((\$J + 1))"
                K="\$((\$K + 1000))"

                TAGNAME="\${{ steps.ts.outputs.TS }}.\$J"

                gh release create "\$TAGNAME" --title "\$TAGNAME" --notes 'These packages are created using [ndk-pkg](https://github.com/leleliu008/ndk-pkg)'
            fi

            TARBALL_FILENAME="\$(sed -n '/bin-url: /p' "\$f" | cut -c10-)"
            TARBALL_URL="https://github.com/\${{ github.repository }}/releases/download/\$TAGNAME/\$TARBALL_FILENAME"

            sed -i "/bin-url: /c bin-url: \$TARBALL_URL" "\$f"

            sleep 1s

            gh release upload "\$TAGNAME" "\$TARBALL_FILENAME"
          done

      - run: mv *.yml formula/

      - run: git config --global user.name  leleliu008
      - run: git config --global user.email leleliu008@gmail.com

      - run: git pull
      - run: git add formula
      - run: git commit -m 'release version \${{ steps.ts.outputs.TS }}'
      - run: git push origin master
EOF

    ##################################

    if [    -d ndk-pkg-formula-repository-official-core ] ; then
        rm -rf ndk-pkg-formula-repository-official-core
    fi

    unset XXXX

    if [   -f foot ] ; then
        rm -f foot
        XXXX=foot
    fi

    if [   -f github-workflows-generate ] ; then
        rm -f github-workflows-generate
        XXXX="$XXXX github-workflows-generate"
    fi

    ##################################

    S="$(git status -s)"

    if [ -z "$S" ] ; then
        continue
    fi

    run git add .github/workflows/publish.yml $XXXX
    run git commit -m "'update github actions workflows'"
    run git push origin master

    echo "\n============================\n"
done
